{
  "name": "chillpass-web",
  "version": "0.2.1",
  "description": "ChillPass - AI 学习助手（Windows 桌面版与浏览器版）",
  "author": "ChillPass",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --config desktop/builder.cjs --win --dir",
    "desktop:dist": "npm run build && electron-builder --config desktop/builder.cjs --win nsis --x64",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "start": "node server.mjs",
    "test:storage": "node scripts/learning-data-regression.cjs && node scripts/storage-regression.cjs",
    "test:updates": "node scripts/check-source-updates.cjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "dompurify": "^3.1.6",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.427.0",
    "marked": "^14.0.0",
    "nanoid": "^5.0.7",
    "pdfjs-dist": "^4.4.168",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "1.61.1",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^3.1.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
